# Server config
PORT=3000
NODE_ENV=development

# PostgreSQL Database
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bfy
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# JWT
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3001

# API
API_VERSION=v1
API_PREFIX=/api
