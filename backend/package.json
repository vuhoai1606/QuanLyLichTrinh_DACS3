{
  "name": "bfy-backend",
  "version": "1.0.0",
  "description": "BFY (Better For Yourself) - Backend API with ElysiaJS",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/bootstrap.ts",
    "build": "bun build src/bootstrap.ts --outdir dist --target=bun",
    "start": "bun src/bootstrap.ts",
    "prod": "bun dist/bootstrap.js",
    "test:setup": "bun run setup-test-db.js",
    "test": "bun run test:setup && bun test"
  },
  "dependencies": {
    "@elysiajs/websocket": "^0.2.8",
    "@google/generative-ai": "^0.24.1",
    "@sinclair/typebox": "^0.34.49",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "elysia": "^1.4.28",
    "elysia-rate-limit": "^4.6.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.7.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "pg": "^8.20.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "^0.3.29",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^8.0.0",
    "@types/uuid": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.3.3"
  }
}
